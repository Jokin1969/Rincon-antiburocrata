# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000

# Directorio de datos persistentes (SQLite, JSON de viajes, adjuntos…)
# En Railway se monta un volumen en /data; en local puedes usar ./data
DATA_DIR=/data

# ── API Keys de IA ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=contraseña_smtp
SMTP_FROM=noreply@ejemplo.com

# Dirección a la que se envían los PDFs (informes de gastos, documentos aduanas…)
CONTACT_EMAIL=destinatario@ejemplo.com

# URL pública de la aplicación (usada para generar QR codes)
APP_URL=https://tu-app.up.railway.app

# ── Hub de impresión física ──────────────────────────────────────────────────
# URL base del servicio hub (proyecto jokin-tools, desplegado en Railway)
PRINT_HUB_URL=https://<jokin-tools>.up.railway.app
# Clave de autenticación del hub — ¡NO subir a git!
PRINT_HUB_KEY=clave_secreta_del_hub
